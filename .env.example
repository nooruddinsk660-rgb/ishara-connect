# Copy this file to .env and fill in real values.
# .env is already gitignored — never commit the real file.

# Flask session/cookie signing key.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# Required for production. Phase 2 added real caregiver login sessions to the
# dashboard, so this is no longer just good practice -- if it's unset, every
# app restart invalidates a fresh random key and logs every caregiver out.
SECRET_KEY=

# Set to true only for local kiosk-mode testing where this exact machine has a
# physical webcam and you want /video_feed to serve it directly. Leave unset
# or false everywhere else -- there is no camera on a cloud host, so this route
# will just error there. Off by default.
ENABLE_LOCAL_WEBCAM_ROUTE=false

# --- Phase 1: Postgres transcript logging (models.py / db.py) ---
# Optional and additive. If unset, the app runs exactly as before -- no DB,
# no logging, no crash. Format: postgresql://user:password@host:5432/dbname
# Local testing: install Postgres, `createdb ishara_connect`, then e.g.:
#   DATABASE_URL=postgresql://ishara:yourpassword@localhost:5432/ishara_connect
DATABASE_URL=

# --- Phase 2: caregiver dashboard ---
# Uses the same DATABASE_URL above. Schema changes now go through Alembic
# instead of create_all() alone:
#   Fresh install:            alembic upgrade head
#   Existing Stage-1 DB:      alembic stamp 4060036d24a9  &&  alembic upgrade head
# Create the first caregiver login (no self-signup exists):
#   python create_caregiver.py --email you@institution.org --name "Your Name"
# Dashboard is then at /dashboard/login.
